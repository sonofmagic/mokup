{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "lib/**",
        "mock/**",
        "worker/**",
        "public/**",
        "docs/**",
        "../mokup/src/**",
        "../runtime/src/**",
        "../../apps/mokup-docs/mock/**",
        "package.json",
        "env.d.ts",
        "wrangler.jsonc",
        "tsconfig*.json",
        "*.config.{js,ts,mjs,mts}"
      ],
      "outputs": [
        "dist/**",
        "bin/**",
        "docs/.vitepress/dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "src/**",
        "lib/**",
        "test/**",
        "mock/**",
        "worker/**",
        "public/**",
        "docs/**",
        "env.d.ts",
        "wrangler.jsonc",
        "*.config.{js,ts,mjs,mts}",
        ".eslintrc*",
        ".stylelintrc*"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "worker:dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "inputs": [
        "src/**",
        "lib/**",
        "test/**",
        "mock/**",
        "worker/**",
        "public/**",
        "docs/**",
        "package.json",
        "env.d.ts",
        "wrangler.jsonc",
        "vitest.config.{js,ts}",
        "tsconfig*.json"
      ],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "inputs": [
        "src/**",
        "mock/**",
        "public/**",
        "worker/**",
        "test/e2e/**",
        "playwright.config.ts",
        "vite.config.ts",
        "webpack.config.ts",
        "package.json"
      ],
      "outputs": [
        "test-results/**",
        "playwright-report/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "src/**",
        "lib/**",
        "test/**",
        "mock/**",
        "worker/**",
        "public/**",
        "docs/**",
        "package.json",
        "env.d.ts",
        "wrangler.jsonc",
        "tsconfig*.json"
      ],
      "outputs": []
    },
    "release": {
      "cache": false
    },
    "sync": {
      "cache": false
    }
  }
}
