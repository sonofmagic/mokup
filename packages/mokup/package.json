{
  "name": "mokup",
  "type": "module",
  "version": "2.3.3",
  "description": "Mock utilities and Vite plugin for mokup.",
  "license": "MIT",
  "homepage": "https://mokup.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/mokup.git",
    "directory": "packages/mokup"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": {
        "import": "./dist/cli.d.mts",
        "require": "./dist/cli.d.cts"
      },
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    },
    "./bundle": {
      "types": {
        "import": "./dist/bundle.d.mts",
        "require": "./dist/bundle.d.cts"
      },
      "import": "./dist/bundle.mjs",
      "require": "./dist/bundle.cjs"
    },
    "./server": {
      "types": {
        "import": "./dist/server.d.mts",
        "require": "./dist/server.d.cts"
      },
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./server/fetch": {
      "types": {
        "import": "./dist/server/fetch.d.mts",
        "require": "./dist/server/fetch.d.cts"
      },
      "import": "./dist/server/fetch.mjs",
      "require": "./dist/server/fetch.cjs"
    },
    "./server/node": {
      "types": {
        "import": "./dist/server/node.d.mts",
        "require": "./dist/server/node.d.cts"
      },
      "import": "./dist/server/node.mjs",
      "require": "./dist/server/node.cjs"
    },
    "./server/worker": {
      "types": {
        "import": "./dist/server/worker.d.mts",
        "require": "./dist/server/worker.d.cts"
      },
      "import": "./dist/server/worker.mjs",
      "require": "./dist/server/worker.cjs"
    },
    "./vite": {
      "types": {
        "import": "./dist/vite.d.mts",
        "require": "./dist/vite.d.cts"
      },
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": {
        "import": "./dist/webpack.d.mts",
        "require": "./dist/webpack.d.cts"
      },
      "import": "./dist/webpack.mjs",
      "require": "./dist/webpack.cjs"
    },
    "./runtime": {
      "types": {
        "import": "./dist/runtime.d.mts",
        "require": "./dist/runtime.d.cts"
      },
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs"
    },
    "./sw": {
      "types": {
        "import": "./dist/sw.d.mts",
        "require": "./dist/sw.d.cts"
      },
      "import": "./dist/sw.mjs",
      "require": "./dist/sw.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "cli": [
        "dist/cli.d.mts"
      ],
      "bundle": [
        "dist/bundle.d.mts"
      ],
      "server": [
        "dist/server.d.mts"
      ],
      "server/fetch": [
        "dist/server/fetch.d.mts"
      ],
      "server/node": [
        "dist/server/node.d.mts"
      ],
      "server/worker": [
        "dist/server/worker.d.mts"
      ],
      "vite": [
        "dist/vite.d.mts"
      ],
      "webpack": [
        "dist/webpack.d.mts"
      ],
      "runtime": [
        "dist/runtime.d.mts"
      ],
      "sw": [
        "dist/sw.d.mts"
      ]
    }
  },
  "bin": {
    "mokup": "./dist/cli-bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "test:types": "tsd",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "html-webpack-plugin": "^5.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "html-webpack-plugin": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@mokup/cli": "workspace:*",
    "@mokup/core": "workspace:*",
    "@mokup/playground": "workspace:*",
    "@mokup/runtime": "workspace:*",
    "@mokup/server": "workspace:*",
    "@mokup/shared": "workspace:*",
    "picocolors": "^1.1.1"
  }
}
