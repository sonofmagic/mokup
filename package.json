{
  "name": "monorepo-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "author": "ice breaker <1324318532@qq.com>",
  "homepage": "https://mokup.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/monorepo-template.git"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/monorepo-template/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:apps": "turbo run build --filter=./apps/*...",
    "dev": "turbo run dev --parallel",
    "docs:build": "pnpm --filter mokup-docs build",
    "docs:deploy": "pnpm --filter mokup-docs worker:deploy",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:types": "pnpm -r --filter \"./packages/*\" --filter \"!./packages/playground\" run test:types",
    "lint": "turbo run lint",
    "lint:lines": "node scripts/lint-lines.mjs",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "typecheck": "turbo run typecheck",
    "format": "eslint . --fix",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "test:e2e": "turbo run test:e2e --filter=./apps/* --concurrency=${E2E_CONCURRENCY:-3}",
    "test:e2e:serial": "turbo run test:e2e --filter=./apps/* --concurrency=1",
    "test:e2e:ui": "turbo run test:e2e --filter=./apps/* --concurrency=${E2E_CONCURRENCY:-3} -- --ui",
    "release": "changeset",
    "publish-packages": "turbo run build lint test && changeset version && changeset publish",
    "------": "--------------",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "commit",
    "commitlint": "commitlint --edit",
    "-------": "---------------",
    "pr:alpha": "changeset pre enter alpha",
    "pr:beta": "changeset pre enter beta",
    "pr:rc": "changeset pre enter rc",
    "pr:exit": "changeset pre exit",
    "--------": "----------------",
    "script:init": "monorepo init",
    "script:sync": "monorepo sync",
    "script:clean": "monorepo clean",
    "script:mirror": "monorepo mirror"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@icebreakers/changelog-github": "^0.2.0",
    "@icebreakers/commitlint-config": "^1.2.7",
    "@icebreakers/eslint-config": "^1.6.19",
    "@icebreakers/monorepo": "latest",
    "@icebreakers/stylelint-config": "^2.0.2",
    "@mokup/shared": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "~4.0.18",
    "ci-info": "^4.4.0",
    "cross-env": "^10.1.0",
    "defu": "^6.1.4",
    "es-toolkit": "^1.44.0",
    "eslint": "^10.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "only-allow": "^1.2.2",
    "pathe": "catalog:",
    "pkg-types": "^2.3.0",
    "rimraf": "^6.1.2",
    "stylelint": "^17.2.0",
    "tsd": "^0.33.0",
    "tsdown": "0.20.3",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "turbo": "^2.8.5",
    "type-fest": "^5.4.4",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "~4.0.18",
    "yaml": "^2.8.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
